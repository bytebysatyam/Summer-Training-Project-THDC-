@model List<LeaveApplication>
@{
    ViewBag.Title = "My Leave Applications";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg rounded-4">
                <div class="card-header bg-info text-white text-center rounded-top-4">
                    <h2 class="mb-0">📋 My Leave Applications</h2>
                </div>
                <div class="card-body p-4">

                    @if (!Model.Any())
                    {
                        TempData["ToastMessage"] = "You have not submitted any Leave Applications yet.";
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered align-middle text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th>Leave Type</th>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Reason</th>
                                        <th>Status</th>
                                        <th>Applied On</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var leave in Model)
                                    {
                                        <tr>
                                            <td>@leave.LeaveType</td>
                                            <td>@leave.StartDate.ToShortDateString()</td>
                                            <td>@leave.EndDate.ToShortDateString()</td>
                                            <td>@leave.Reason</td>
                                            <td>
                                                @if (leave.Status == "Approved")
                                                {
                                                    <span class="badge bg-success px-3 py-2">Approved</span>
                                                }
                                                else if (leave.Status == "Rejected")
                                                {
                                                    <span class="badge bg-danger px-3 py-2">Rejected</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark px-3 py-2">Pending</span>
                                                }
                                            </td>
                                            <td>@leave.AppliedOn.ToString("g")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

