@using WebPage.Controllers
@model LoginViewModel

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow p-4" style="width: 400px;">
        <div class="d-flex justify-content-center">
            <img src="https://img.freepik.com/free-vector/creative-gradient-code-logo_23-2148820572.jpg" alt="Logo" width="259" height="90" class="me-2" />
        </div>

        <h3 class="text-center mb-3">Login Here</h3>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }


        <form asp-action="Login" method="post">
            <div class="form-group mb-3">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="Enter your Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password">
                </label>
                <input asp-for="Password" class="form-control" placeholder="Enter Password"/>
                
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <div class="d-flex justify-content-end mb-2">
                <a href="/Account/ForgotPassword" class="btn btn-link">Forgot Password?</a>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-success">Login</button>
                </div>
                <div class="text-center">
                <a href="/Account/Register" class="btn btn-link">Don't have an account? Register</a>
                </div>
            

        </form>
    </div>
</div>
