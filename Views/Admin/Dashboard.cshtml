@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
}

@{
    ViewData["Title"] = "Dashboard";
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userRole = Context.Session.GetString("UserRole");
}


<!-- ✅ HEADER SECTION -->
<div class="container-fluid p-0 m-0">
    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom bg-white flex-wrap w-100">

        <!-- 🔹 Left: Logo + Text -->
        <div class="d-flex flex-column align-items-start">

            <img src="https://img.freepik.com/free-vector/creative-gradient-code-logo_23-2148820572.jpg" alt="THDC Logo" style="height: 60px;" class="mb-1">
            <span class="text-primary fw-semibold px-3 py-0 border-bottom px-3 py-0 border-top">Schedule-A Mini Ratna PSU</span>
        </div>

        <!-- 🔹 Middle: Welcome -->

        <div class="d-flex justify-content-between align-items-center px-3 py-3 border-bottom bg-white">

            <div>
                @if (!string.IsNullOrEmpty(fullName))
                {
                    <span class="fw-bold text-primary"> <h1 class="m-0">Welcome, @fullName</h1></span>
                }
                else
                {
                    <span class="text-muted">Welcome, Guest</span>
                }
          
            </div>
        </div>






        <!-- 🔹 Right: Search Bar -->
        <form class="d-flex mt-2 mt-lg-0">
            <input type="text" class="form-control me-2" placeholder="Search..." style="min-width: 200px;">
            <button class="btn btn-outline-secondary" type="submit">🔍</button>
        </form>
    </div>
</div>

