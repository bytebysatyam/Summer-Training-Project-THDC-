@model List<Complaint>

@{
    ViewData["Title"] = "All Complaints";
}

<!-- Page Background Color -->
<style>
    body {
        background-color: khaki; /* Soft professional background */
    }
</style>

<div class="container my-5">
    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h3 class="mb-0">🛠 All Complaints</h3>
            <div class="mt-4">
                <a href="/Pdf/ExportComplaints" class="btn btn-danger">Download Complaints PDF</a>
            </div>
        </div>
        <div class="card-body bg-white rounded-bottom-4">
            <table class="table table-bordered table-hover table-striped align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Subject</th>
                        <th>Description</th>
                        <th>User Email</th>
                        <th>Date Created</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var complaint in Model)
                    {
                        <tr>
                            <td>@complaint.Id</td>
                            <td>@complaint.Subject</td>
                            <td>@complaint.Description</td>
                            <td>@complaint.UserEmail</td>
                            <td>@complaint.DateCreated.ToString("dd-MM-yyyy HH:mm")</td>
                            <td>
                                @if (complaint.Status == "Resolved")
                                {
                                    <span class="badge bg-success">Resolved</span>
                                }
                                else if (complaint.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrEmpty(complaint.AdminResponse))
                                {
                                    <a class="btn btn-sm btn-primary" href="@Url.Action("Respond", "Admin", new { id = complaint.Id })">
                                        ✏️ Respond
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary" disabled>
                                        ✅ Responded
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
